### BEGIN /etc/grub.d/00_header ###
set is_preload=true
###grub-password begin
###grub-password end
set have_grubenv=true
load_env
set timeout="1"
font=$prefix/fonts/unicode.pf2
insmod font
set locale_dir=$prefix/locale
set lang=en_US
insmod gettext
if [ "${next_entry}" ] ; then
   set default="${next_entry}"
   set next_entry=
   save_env next_entry
   set boot_once=true
else
   set default="0"
fi
### END /etc/grub.d/00_header ###

### BEGIN /etc/grub.d/01_sw_settings ###
### END /etc/grub.d/01_sw_settings ###

### BEGIN /etc/grub.d/05_debian_theme ###
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray
### END /etc/grub.d/05_debian_theme ###

### BEGIN /etc/grub.d/06_ubuntukylin_theme ###
insmod part_gpt
insmod ext2
if [ x$feature_platform_search_hint = xy ]; then
  search --no-floppy --fs-uuid --set=root  eb34825f-907a-4f97-a5dc-ff7dc84d00a0
else
  search --no-floppy --fs-uuid --set=root eb34825f-907a-4f97-a5dc-ff7dc84d00a0
fi
insmod gfxmenu
loadfont ($root)/usr/share/grub/themes/UKUI/unifont-bold-16.pf2
loadfont ($root)/usr/share/grub/themes/UKUI/unifont-regular-16.pf2
insmod png
set theme=($root)/usr/share/grub/themes/UKUI/theme_en.txt
export theme
### END /etc/grub.d/06_ubuntukylin_theme ###

