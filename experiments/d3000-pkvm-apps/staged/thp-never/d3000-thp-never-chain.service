[Unit]
Description=Launch full D3000 THP=never follow-up after the primary campaign
After=network-online.target d3000-pkvm-campaign.service
Wants=network-online.target
ConditionPathExists=/home/jose/kylin-lmbench-exp/state/thp-never-pending
ConditionPathExists=!/home/jose/kylin-lmbench-exp/state/campaign-enabled

[Service]
Type=oneshot
User=jose
Group=jose
WorkingDirectory=/home/jose/kylin-lmbench-exp
ExecStart=/usr/bin/flock -n /home/jose/kylin-lmbench-exp/state/campaign.lock /home/jose/kylin-lmbench-exp/staged/thp-never/launch-pending-thp-never.sh
TimeoutStartSec=infinity
StandardOutput=append:/home/jose/kylin-lmbench-exp/logs/campaign-service.log
StandardError=append:/home/jose/kylin-lmbench-exp/logs/campaign-service.log

[Install]
WantedBy=multi-user.target
