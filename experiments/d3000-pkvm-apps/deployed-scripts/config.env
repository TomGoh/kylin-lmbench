# D3000 pKVM application benchmark campaign configuration.
# This file is sourced by Bash; keep values shell-safe.

EXP_HOME=/home/jose/kylin-lmbench-exp
WORK_ROOT=/kylin-lmbench-exp-work
TOOLS_DIR=/home/jose/kylin-lmbench-exp/tools
SRC_DIR=/home/jose/kylin-lmbench-exp/src
BUILD_DIR=/home/jose/kylin-lmbench-exp/build
RESULTS_DIR=/home/jose/kylin-lmbench-exp/results
STATE_DIR=/home/jose/kylin-lmbench-exp/state
LOG_DIR=/home/jose/kylin-lmbench-exp/logs

SERVER_CPUS=0-3
CLIENT_CPUS=4-7
ALL_CPUS=0-7
# Formal campaigns use one global THP policy at a time. The required sequence is
# a full THP=never campaign followed by a separate full THP=always campaign.
THP_PROFILE=${THP_PROFILE:-never}
COOLDOWN_SECONDS=${COOLDOWN_SECONDS:-30}
REPETITIONS=${REPETITIONS:-5}

REDIS_VERSION=8.8.0
REDIS_SOURCE_SHA256=19736ce6117d90b3df032504c6e5c1ce41667ae47f073281b40d2f274c200a74
MEMTIER_VERSION=2.3.1
MEMTIER_SOURCE_SHA256=0b63a9289399dbf7e04ee2213d0229c831274bb8f64ef8ff2e8f36896aa34146
RABBITMQ_VERSION=4.3.1
PERFTEST_VERSION=2.25.0
PERFTEST_SHA256=ceba54374fcbb9da113b85b3946273031ac29f24cf2a0bb90b34b613fa9867cf
RABBITMQ_IMAGE=rabbitmq:4.3.1-management
GEEKBENCH_ARCHIVE=/home/jose/kylin-lmbench-exp/utils/Geekbench-6.7.1-LinuxARMPreview.tar.gz
GEEKBENCH_SHA256=6e59acb83e6dea3671e2e295365fc37c40fdd280cdbddd50acf248910e14a0e3

REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_USER=pkvmbench
RABBITMQ_PASSWORD=pkvmbench-local-only

# Redis formal durations in seconds. Override only for an explicitly labelled smoke run.
REDIS_STEADY_SECONDS=${REDIS_STEADY_SECONDS:-300}
REDIS_THROUGHPUT_SECONDS=${REDIS_THROUGHPUT_SECONDS:-180}
REDIS_BGSAVE_SECONDS=${REDIS_BGSAVE_SECONDS:-360}
REDIS_CALIBRATION_SECONDS=${REDIS_CALIBRATION_SECONDS:-180}

# RabbitMQ formal duration. The first 60 seconds are discarded in analysis.
RABBIT_STEADY_SECONDS=${RABBIT_STEADY_SECONDS:-360}
RABBIT_CALIBRATION_SECONDS=${RABBIT_CALIBRATION_SECONDS:-180}
RABBIT_WARMUP_SECONDS=${RABBIT_WARMUP_SECONDS:-60}
RABBIT_Q3_PRODUCERS=${RABBIT_Q3_PRODUCERS:-8}
RABBIT_Q3_RATE_TOLERANCE_PCT=${RABBIT_Q3_RATE_TOLERANCE_PCT:-5}
RABBIT_Q3_RATE_DISCARD_SECONDS=${RABBIT_Q3_RATE_DISCARD_SECONDS:-60}
RABBIT_Q3_RATE_MIN_SAMPLES=${RABBIT_Q3_RATE_MIN_SAMPLES:-120}
RABBIT_Q5_MESSAGES=${RABBIT_Q5_MESSAGES:-1000000}
RABBIT_Q5_TIMEOUT_SECONDS=${RABBIT_Q5_TIMEOUT_SECONDS:-1800}

# Safety guards. Large transient data lives on WORK_ROOT, not /home.
MIN_ROOT_FREE_GIB=100
MIN_HOME_FREE_GIB=10
